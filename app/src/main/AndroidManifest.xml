<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <queries>
        <!-- Allow querying/launching Amap Auto on Android 11+ -->
        <package android:name="com.autonavi.amapauto" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 保持屏幕常亮和防止休眠权限 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.DISABLE_KEYGUARD" />

    <!-- 前台服务权限 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Android 13+ notification runtime permission for foreground service notifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 忽略电池优化权限 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- 位置权限 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- MockLocation权限已移至 src/debug/AndroidManifest.xml（Release lint要求） -->

    <!-- 网络权限 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <!-- 图片选择和相机权限 -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    
    <!-- 蓝牙权限（LED点阵屏连接） -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />

    <!-- 附近 WiFi 设备权限 -->
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" />

    <!-- 安装包权限 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- 传感器和硬件功能 -->
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="true" />
    <uses-feature android:name="android.hardware.sensor.compass" android:required="true" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <application
        android:name="com.example.navipilot.CarrotApplication"
        android:allowBackup="true"
        android:largeHeap="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Navipilot"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">

        <!-- 腾讯地图SDK Key -->
        <meta-data
            android:name="TencentMapSDK"
            android:value="OSYBZ-XNXCV-KKGPD-5BSPY-FSFWH-FNFHU" />

        <!-- 高德 Key：3dmap/导航 SDK 读取 com.amap.api.v2.apikey（与官方 NaviDemo 一致）；保留 autonavi 项以兼容旧代码 -->
        <meta-data
            android:name="com.amap.api.v2.apikey"
            android:value="0baffde609d29faa1258396d634594f8" />
        <meta-data
            android:name="com.autonavi.amapapi.API_KEY"
            android:value="0baffde609d29faa1258396d634594f8" />

        <!-- 高德定位融合服务（合并 JAR 内含定位模块，缺此 Service 时部分鉴权/网络层异常） -->
        <service android:name="com.amap.api.location.APSService" />

        <!-- Google Maps API Key（用于 Navigation SDK） -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <!-- 禁用OAID获取，避免非OPPO设备上 com.heytap.openid 包找不到的异常 -->
        <meta-data
            android:name="com.heytap.openid.disable"
            android:value="true" />
        <activity
            android:name="com.example.navipilot.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Navipilot"
            android:launchMode="singleTask"
            android:screenOrientation="unspecified"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:excludeFromRecents="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- LicenseVerificationActivity 已移除 -->

        <!-- 前台服务 - 用于保持应用在后台稳定运行 -->
        <service
            android:name="com.example.navipilot.CarrotAmapForegroundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location"
            android:stopWithTask="false">
        </service>

        <!-- Google 导航 NavInfo 接收服务（用于获取 TBT 转弯数据） -->
        <service
            android:name=".navigation.GoogleNavInfoService"
            android:exported="false" />

        <receiver
            android:name="com.example.navipilot.AmapAutoStaticReceiver"
            android:exported="true"
            android:enabled="true"
            android:permission="android.permission.INTERNET">
            <intent-filter android:priority="1000">
                <action android:name="AUTONAVI_STANDARD_BROADCAST_SEND" />
                <action android:name="AMAP_BROADCAST_SEND" />
                <action android:name="AUTONAVI_BROADCAST_SEND" />
                <action android:name="AMAP_NAVI_ACTION_UPDATE" />
                <action android:name="AMAP_NAVI_ACTION_TURN" />
                <action android:name="AMAP_NAVI_ACTION_ROUTE" />
                <action android:name="AMAP_NAVI_ACTION_LOCATION" />
            </intent-filter>
        </receiver>

        <!-- FileProvider - 用于分享图片等文件 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        
    </application>

</manifest>