# Public HTTPS address used by Z-Pay when it sends payment notifications.
APP_PUBLIC_URL=https://your-domain.example

# In 1Panel, this is a CONTAINER path. Mount a persistent host directory to
# /app/data, then use the path below. Do not put a host path here.
DATABASE_PATH=/app/data/commerce.db
RELEASE_DIRECTORY=/app/data/releases

# Optional public pricing catalog. It contains no secrets and can be edited before restart.
# CATALOG_PATH=/opt/carrot-commerce/catalog.json

# Obtain these values from the Z-Pay merchant console. Never put them in the APK or Git.
ZPAY_PID=
ZPAY_KEY=
ZPAY_SUBMIT_URL=https://zpayz.cn/submit.php
ZPAY_API_URL=https://zpayz.cn/api.php

# Required to enable the protected release management page.
# Generate with:
# python3 -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('choose-a-long-password'))"
COMMERCE_SESSION_SECRET=
COMMERCE_ADMIN_PASSWORD_HASH=
